<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.34.0">
  <bpmn:process id="document_approval" name="Document Approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" />
    <bpmn:userTask id="SubmitDocument" default="f2" camunda:assignee="creator">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${taskAssignListener}" event="create" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="ManagerApprove" default="f3" camunda:assignee="manager">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${taskAssignListener}" event="create" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0qe47rn</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ManagerDecision" name="Manager Decision" />
    <bpmn:serviceTask id="RetrieveDocumentAmount" name="Retrieve Document Amount" camunda:type="external" camunda:topic="retrieveDocumentAmount">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_RetrieveAmountError" name="Retrieve Failed" attachedToRef="RetrieveDocumentAmount">
      <bpmn:outgoing>Flow_RetrieveError</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Retrieve" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="CheckValue" name="Check Value" default="f_value_low" />
    <bpmn:userTask id="DirectorApprove" camunda:assignee="director">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${taskAssignListener}" event="create" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="DirectorDecision" name="Director Decision" />
    <bpmn:userTask id="ReviseDocument" name="Revise Document" camunda:assignee="creator">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${taskAssignListener}" event="create" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ReviseDecision" name="Revise Decision" />
    <bpmn:endEvent id="ApprovedEnd" name="Approved" />
    <bpmn:endEvent id="RejectedEnd" name="Rejected">
      <bpmn:incoming>Flow_0w5muvo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="StartEvent_1" targetRef="SubmitDocument" />
    <bpmn:sequenceFlow id="f2" sourceRef="SubmitDocument" targetRef="Activity_00dutd8" />
    <bpmn:sequenceFlow id="f3" sourceRef="ManagerApprove" targetRef="ManagerDecision" />
    <bpmn:sequenceFlow id="f4" name="Approved" sourceRef="ManagerDecision" targetRef="RetrieveDocumentAmount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"> ${managerApproved == 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f5_reject_manager" name="Rejected" sourceRef="ManagerDecision" targetRef="ReviseDocument">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"> ${managerApproved == 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_amount_retrieved" sourceRef="RetrieveDocumentAmount" targetRef="CheckValue" />
    <bpmn:sequenceFlow id="f_value_high" name="Value &#62; 10M" sourceRef="CheckValue" targetRef="DirectorApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 10000000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_value_low" name="Value &#60;= 10M" sourceRef="CheckValue" targetRef="ApprovedEnd" />
    <bpmn:sequenceFlow id="f6" sourceRef="DirectorApprove" targetRef="DirectorDecision" />
    <bpmn:sequenceFlow id="f7" name="Approved" sourceRef="DirectorDecision" targetRef="ApprovedEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${directorApproved == 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f8_reject_director" name="Rejected" sourceRef="DirectorDecision" targetRef="ReviseDocument">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${directorApproved == 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_revise_flow" sourceRef="ReviseDocument" targetRef="ReviseDecision" />
    <bpmn:sequenceFlow id="f_resubmit" name="Resubmit" sourceRef="ReviseDecision" targetRef="ManagerApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_cancel" name="Cancel" sourceRef="ReviseDecision" targetRef="RejectedEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RetrieveError" sourceRef="Event_RetrieveAmountError" targetRef="ReviseDocument" />
    <bpmn:serviceTask id="Activity_00dutd8" name="VerifyEmail" camunda:type="external" camunda:topic="sendVerificationEmail">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>Flow_10uzcam</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_10uzcam" sourceRef="Activity_00dutd8" targetRef="Gateway_1o7voq7" />
    <bpmn:exclusiveGateway id="Gateway_1o7voq7">
      <bpmn:incoming>Flow_10uzcam</bpmn:incoming>
      <bpmn:outgoing>Flow_0qe47rn</bpmn:outgoing>
      <bpmn:outgoing>Flow_0w5muvo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0qe47rn" sourceRef="Gateway_1o7voq7" targetRef="ManagerApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${emailVerificationSent== 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0w5muvo" sourceRef="Gateway_1o7voq7" targetRef="RejectedEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${emailVerificationSent== 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
